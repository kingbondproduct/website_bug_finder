# SQLite database. Path is resolved relative to prisma/schema.prisma,
# so ../data/dev.db places the file at <repo-root>/data/dev.db
DATABASE_URL="file:../data/dev.db"

# API server
PORT=3001

# Crawl defaults
CRAWL_MAX_DEPTH=1
CRAWL_MAX_PAGES=60
CRAWL_PAGE_CONCURRENCY=3
PERF_LOAD_THRESHOLD_MS=4000
