{
  "name": "website_bug_finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Automated & manual web crawler and bug-detection platform for the Ather Energy website (desktop + mobile).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:reset": "prisma migrate reset --force",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "npm --workspace @bugfinder/web run dev",
    "build": "npm --workspace @bugfinder/web run build",
    "start": "tsx apps/api/src/server.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
